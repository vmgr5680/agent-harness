# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# Nothing here is read at import time. Settings are resolved once, explicitly,
# by agent_harness.config.load_settings().

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# With no key the project runs OfflineLlm: deterministic, no network, no cost.
# Every test, the demo and the eval suite work in that mode.
#
# With a key it runs Gemini through ADK. Create one at:
#   https://aistudio.google.com/apikey
#
# google-genai reads GOOGLE_API_KEY. Most Gemini documentation says
# GEMINI_API_KEY. Either works here — agents/models.py reconciles them and
# removes the duplicate, because having both set produces a warning and a
# silent precedence rule.
GOOGLE_API_KEY=

# An AI Studio key is the Gemini API, not Vertex AI. Leave this FALSE unless
# you are genuinely on Vertex with application default credentials.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# offline | gemini. Defaults to gemini when a key is present, so configuring a
# key and silently still getting the offline model cannot happen.
AH_PROVIDER=

# Model ids move faster than documentation. Run `agent-harness models` to list
# what your key can actually call before trusting any id from a tutorial.
AH_MODEL_DEEP=gemini-3.1-flash-lite
# Subagents that fetch and quote can run on something cheaper than the agent
# that writes the customer-facing answer. Both default to AH_MODEL_DEEP.
AH_MODEL_FAST=
AH_MODEL_JUDGE=

# ---------------------------------------------------------------------------
# Termination ceilings — three of them, any one ends a run. Do not remove.
# ---------------------------------------------------------------------------
# Enforced by ADK itself (RunConfig.max_llm_calls).
AH_MAX_MODEL_CALLS=12
# Enforced by the harness.
AH_RUN_TIMEOUT_S=120
AH_BUDGET_USD_PER_RUN=0.05
AH_BUDGET_USD_PER_TENANT_DAY=25.00

# ---------------------------------------------------------------------------
# Economics
# ---------------------------------------------------------------------------
AH_RATE_LIMIT_RPM=60
AH_RATE_LIMIT_BURST=10

# IMPORTANT. The built-in price table does not know every model, and an unknown
# model is charged at the most expensive known rate — loudly, on purpose, so an
# unpriced model is visible rather than free. If `agent-harness health` reports
# "model_price_known": false, set the real rates here (USD per 1M tokens, from
# https://ai.google.dev/pricing) or every cost figure you see is an over-estimate.
# AH_PRICING_JSON={"gemini-3.1-flash-lite":{"input":0.10,"output":0.40,"cached_input":0.025}}

# ---------------------------------------------------------------------------
# Guardrails — ADK provides none of this. Roll out in this order.
# ---------------------------------------------------------------------------
# off     rails do not run (dev only; config refuses it outside AH_ENV=dev)
# shadow  rails run, findings are logged and metered, nothing is changed
# enforce rails are authoritative
# Never start at enforce. Shadow until the finding rate is boring.
AH_GUARDRAIL_MODE=enforce
AH_GUARDRAIL_MAX_INPUT_CHARS=8000
# true blocks personal data in an answer instead of redacting it. A real policy
# fork: redact for an internal support tool, block for anything public.
AH_GUARDRAIL_STRICT_OUTPUT=false

# ---------------------------------------------------------------------------
# Sessions and observability
# ---------------------------------------------------------------------------
# Empty uses ADK's InMemorySessionService. A URL uses DatabaseSessionService,
# which persists every event of every run — that IS the audit trail.
#
# ADK 2.9's DatabaseSessionService is async-only. The URL every developer
# already knows is the synchronous one, and it fails at startup:
#   sqlite:///./var/sessions.db          WRONG — synchronous driver
#   sqlite+aiosqlite:///./var/sessions.db
#   postgresql+asyncpg://user:pass@host/db
AH_SESSION_DB_URL=

AH_LOG_LEVEL=INFO
# json in production; text at a terminal.
AH_LOG_FORMAT=json
AH_SERVICE_NAME=agent_harness
AH_ENV=dev

# ---------------------------------------------------------------------------
# API auth — "token:tenant:scope|scope" triples, comma separated.
# Development grade. Replace with your identity provider before this leaves a
# laptop; what should survive the swap is the shape, where the caller never
# states its own tenant or its own scopes.
# ---------------------------------------------------------------------------
# Quoted because the scope separator is `|`, and the README's
# `set -a && source .env && set +a` would otherwise read it as a shell pipeline.
AH_SERVICE_TOKENS='dev-token-abc:acme:agent.run|evals.run|kb.read|orders.read|orders.write'
